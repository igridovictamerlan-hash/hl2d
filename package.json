{
  "name": "hl2d",
  "private": true,
  "version": "0.1.0",
  "description": "2D top-down HL2RP-like city simulation (City 17) in the browser",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "mapstats": "vitest run tests/mapstats.test.ts --reporter=verbose"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
